# Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:1.5b

# GitHub: a token with "repo" scope. ASEA publishes to whichever GitHub
# repository you analyse (its default branch). If the token cannot push
# to that repository, ASEA forks it and opens the PR from the fork.
GITHUB_TOKEN=

# Optional performance tuning
# ASEA_MAX_LLM_FILES=40      # max files sent to the LLM per run
# ASEA_LLM_WORKERS=1         # raise only if OLLAMA_NUM_PARALLEL > 1
# ASEA_LLM_TIMEOUT=90        # seconds per LLM request
# ASEA_MAX_SOURCE_CHARS=8000 # source chars sent per file
# ASEA_CORS_ORIGINS=         # extra comma-separated frontend origins
